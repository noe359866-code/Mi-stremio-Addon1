# ── Catálogos que se envuelven ────────────────────────────────────────────
# Cinemeta por defecto. Puedes poner hasta 6 URLs separadas por comas o líneas.
UPSTREAM_MANIFEST_URLS=https://v3-cinemeta.strem.io/manifest.json
# Dos mejoras independientes: badge nativo de Stremio y póster con notas dibujadas.
WRAP_NATIVE_BADGE=true
WRAP_POSTER_OVERLAY=true
# Presupuesto y concurrencia para enriquecer cada página de catálogo.
WRAP_CATALOG_TIME_BUDGET_MS=4000
WRAP_CATALOG_CONCURRENCY=6

# ── Claves ────────────────────────────────────────────────────────────────
# TMDB (API oficial, gratis): https://www.themoviedb.org/settings/api
# Si TMDB_API_TOKEN (v4 read access token) está presente, se usa en vez de la key.
TMDB_API_KEY=
TMDB_API_TOKEN=
# OMDb (https://www.omdbapi.com/apikey.aspx, 1000 peticiones/día gratis):
# respaldo para IMDb + Rotten Tomatoes + Metacritic cuando el scraper está bloqueado.
OMDB_API_KEY=
# Metacritic usa la apiKey pública de su propio backend; sólo cámbiala si caduca.
METACRITIC_API_KEY=
METACRITIC_API_VERSION=4.2

# ── Fuentes activas (lista separada por comas) ────────────────────────────
RATINGS_SOURCES=imdb,rottentomatoes,metacritic,filmaffinity,tmdb

# ── Nota que sale en el badge ⭐ de Stremio ───────────────────────────────
# combined | imdb | rt_tomatometer | mc_metascore | filmaffinity | tmdb
BADGE_METRIC=combined

# ── Pesos de la nota combinada (0 desactiva la métrica) ───────────────────
WEIGHT_IMDB=1.0
WEIGHT_RT=0.95
WEIGHT_METACRITIC=0.9
WEIGHT_FILMAFFINITY=0.7
WEIGHT_TMDB=0.55
WEIGHT_RT_AUDIENCE=0.45
WEIGHT_MC_USER=0.45
MIN_VOTES_IMDB=500
MIN_VOTES_TMDB=250
MIN_VOTES_FA=250

# ── Aspecto de la ficha ───────────────────────────────────────────────────
SHOW_PANEL=true
SHOW_UNAVAILABLE=true
SHOW_LINKS=true
SHOW_EMOJI=true
RATINGS_LANGUAGE=es-ES
ADDON_NAME=Puntuaciones en tus pósters

# ── Catálogos legacy (no filtran los catálogos envueltos) ─────────────────
CATALOG_LIMIT=50
MIN_SCORE=0
MAX_SCORE=10
INCLUDE_ADULT=false
ENRICH_SEARCH=false

# ── Red / caché ───────────────────────────────────────────────────────────
CACHE_TTL_HOURS=24
CHART_TTL_HOURS=6
FETCH_TIMEOUT_MS=9000
FETCH_RETRIES=1
PER_HOST_MS=700
RETRY_ON_NEW_ID=true
LOG_VERBOSE=false

# ── Servidor ──────────────────────────────────────────────────────────────
PORT=7000
HOST=0.0.0.0
# URL pública (necesaria si estás detrás de un proxy): se usa para el logo/fondo
PUBLIC_URL=
# true = datos simulados (demo sin red, para probar el addon entero)
RATINGS_MOCK=0

# --- anime: AniList y MyAnimeList -------------------------------------------
# AniList no necesita nada (API GraphQL pública). Con esto MAL usa la API oficial
# en vez de Jikan: crea una app en https://myanimelist.net/forum/?topicid=1973139
# y usa su "Client ID" (la API pública no pide OAuth para leer).
MAL_CLIENT_ID=
# Endpoint alternativo si quieres autohospedar Jikan o usar un proxy propio.
JIKAN_BASE_URL=
ANILIST_GRAPHQL_URL=
