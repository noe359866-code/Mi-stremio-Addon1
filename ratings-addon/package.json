{
  "name": "stremio-ratings-addon",
  "version": "2.0.0",
  "description": "Envuelve catálogos existentes de Stremio y añade puntuaciones nativas y pósters con notas de IMDb, Rotten Tomatoes, Metacritic, FilmAffinity, TMDB y anime.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "RATINGS_MOCK=1 PORT=7000 node --watch server.js",
    "demo": "RATINGS_MOCK=1 PORT=7000 node server.js",
    "test": "node --test-reporter=spec --test \"test/*.test.js\"",
    "verify": "node scripts/verify.js",
    "check:netlify": "node scripts/verify.js"
  },
  "keywords": [
    "stremio",
    "addon",
    "ratings",
    "imdb",
    "rottentomatoes",
    "metacritic",
    "filmaffinity",
    "tmdb",
    "anime"
  ],
  "author": "Rebzyyx",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "stremio-addon-linter": "^1.7.0"
  }
}
